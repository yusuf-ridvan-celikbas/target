<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: stand-ins for Lilies Lib (picker, add-book, library provider), used when the real app doesn't answer. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".debug.FakeLiliesPickerActivity"
            android:exported="false"
            android:theme="@style/Theme.Target">
            <intent-filter>
                <action android:name="com.ridvan.target.action.PICK_BOOK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.ridvan.target.action.ADD_BOOK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <provider
            android:name=".debug.FakeLiliesProvider"
            android:authorities="${applicationId}.fakelilies"
            android:exported="false" />
    </application>
</manifest>
