    <!-- Help (ui/help/HelpScreen.kt) -->
    <string name="help_getting_started_title">Getting Started</string>
    <string name="help_getting_started_body">Register creates a new account with your name and a password; Login signs into an existing one. You can add more accounts anytime and switch between them from the account menu (⋮ → Account → Switch Account) without losing any data.</string>
    <string name="help_exams_title">Exams</string>
    <string name="help_exams_body">Add an exam from the Exams screen, choosing its type (University Entrance, High School Entrance, Language, or Vocational). If the exam has sections (like TYT/AYT), courses are picked per section instead of one flat list. A Language Exam has a single language field instead of a course pool.</string>
    <string name="help_courses_title">Courses</string>
    <string name="help_courses_body">Courses are organized by exam type — tap Courses in the menu, pick a bucket, and either browse or tap the arrow to preview and jump straight to a course. Each course can have an icon and, for University/High School/Vocational courses, a Quantitative or Verbal category for grouping.</string>
    <string name="help_study_resources_title">Study Resources</string>
    <string name="help_study_resources_body">A Study Resource is a book, question bank, or other material you\'re using for a course or language — give it a type (Question Bank, Lecture/Textbook, Practice Exam, or Lecture Notes) and an optional publisher. Reach them from a course\'s page, or browse everything at once from Study Resources in the menu.</string>
    <string name="help_topics_title">Topics</string>
    <string name="help_topics_body">For Question Bank resources, track how many tests and questions cover each topic. A topic\'s page shows the total across every Question Bank that covers it, broken down by publisher — useful for comparing how thoroughly different books cover the same topic. Reorder a resource\'s topic list by pressing and holding the handle.</string>
    <string name="help_languages_title">Languages</string>
    <string name="help_languages_body">Languages (like French or German) work like courses but for Language Exams — manage them from the Languages menu item, or from a Language Exam\'s own page.</string>
    <string name="help_shortcuts_title">Quick Shortcuts</string>
    <string name="help_shortcuts_body">In Courses, Study Resources, and Topics, tap the arrow next to an exam type to expand it in place and jump straight to a course — no need to open the full list first.</string>
    <string name="help_backup_title">Backing Up a Course\'s Question Banks</string>
    <string name="help_backup_body">From a course\'s page, Export saves all its Question Bank topics and counts to a CSV file you can share or save anywhere. Import reads that same format back in — matching resources by name and publisher, updating counts for topics that already exist and adding anything new.</string>
    <string name="help_settings_title">Settings</string>
    <string name="help_settings_body">Change the app\'s theme, switch between the white and blue launcher icons, and pick English or Turkish from Settings, reached from the ⋮ menu.</string>

    <string name="cd_help_has_sections">Has sections help</string>
    <string name="help_tooltip_has_sections">Whether this exam has sections is decided now and can\'t be changed later.</string>
    <string name="cd_help_course_category">Category help</string>
    <string name="help_tooltip_course_category">Quantitative/Verbal groups this course in the Courses, Study Resources, and Topics lists.</string>
    <string name="cd_help_study_resource_type">Resource type help</string>
    <string name="help_tooltip_study_resource_type">Only Question Bank resources attached to a course get a Topics section.</string>
    <string name="cd_help_topics_practice">Topics help</string>
    <string name="help_tooltip_topics_practice">Practice Sessions track ongoing progress toward a topic\'s target. Practice Exams (in the section above) record one full mock exam\'s result instead.</string>
    <string name="cd_help_net_score">Net score help</string>
    <string name="help_tooltip_net_score">Net = doğru − yanlış ÷ 4, the standard Turkish exam scoring formula.</string>
    <string name="cd_help_remaining_counts">Remaining help</string>
    <string name="help_tooltip_remaining_counts">Target minus everything logged so far. New sessions can\'t push the total past target.</string>
    <string name="cd_help_stats_period">Period help</string>
    <string name="help_tooltip_stats_period">Narrows both the numbers and the chart to a recent window ending today.</string>
    <string name="cd_help_stats_source">Source help</string>
    <string name="help_tooltip_stats_source">Switches the data source between logged Practice Sessions and completed Practice Exams.</string>
    <string name="cd_help_course_export">Export help</string>
    <string name="help_tooltip_course_export">Exports only this course\'s Question Bank resources and their topics as a CSV — one-way, nothing is read back in.</string>
    <string name="cd_help_course_import">Import help</string>
    <string name="help_tooltip_course_import">Matches existing resources by name + publisher and overwrites their topic counts. New resources or topics are added.</string>
    <string name="cd_help_app_color_preference">App color help</string>
    <string name="help_tooltip_app_color_preference">Blue uses your wallpaper\'s live colors (Material You). Any other color stays fixed regardless of wallpaper.</string>
    <string name="cd_help_preferred_name">Preferred name help</string>
    <string name="help_tooltip_preferred_name">Stays live — editing the source field later (e.g. First Name) updates your preferred name automatically.</string>
    <string name="cd_help_course_exam_type">Exam type help</string>
    <string name="help_tooltip_course_exam_type">Reassigning this moves the course to a different bucket everywhere it\'s listed.</string>
    <string name="cd_help_exam_language">Language help</string>
    <string name="help_tooltip_exam_language">Tap the language name to open its own page. A Language Exam has no course list — just this one field.</string>
    <string name="cd_help_course_topics_vs_resources">Topics vs Study Resources help</string>
    <string name="help_tooltip_course_topics_vs_resources">Topics track target vs. actual progress. Study Resources lists the materials themselves.</string>
</resources>
